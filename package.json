{
	"name": "split-mui-imports",
	"displayName": "Split MUI Imports",
	"description": "Splits grouped Material-UI imports",
	"publisher": "DarkPhoenix",
	"version": "0.3.1",
	"engines": {
		"vscode": "^1.90.0"
	},
	"icon": "images/logo.png",
	"categories": ["Formatters"],
	"activationEvents": [
		"onLanguage:javascript",
		"onLanguage:typescript",
		"onLanguage:javascriptreact",
		"onLanguage:typescriptreact"
	],
	"main": "./extension.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/0DarkPhoenix/split-mui-imports.git"
	},
	"contributes": {
		"commands": [
			{
				"command": "splitMuiImports.split",
				"title": "Split MUI Imports: split MUI imports"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Split MUI Imports",
			"properties": {
				"splitMuiImports.runOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Run the Split MUI Imports command on save"
				},
				"splitMuiImports.showInfoMessages": {
					"type": "boolean",
					"default": false,
					"description": "Show information messages"
				},
				"splitMuiImports.allowedImports": {
					"type": "array",
					"default": ["@mui/icons-material", "@mui/material", "@mui/lab"],
					"description": "Imports that will be split when detected by the extension. \nThe path must be literal, meaning that it won't automatically split import strings with children when a parent is detected. \nFor example, '@mui/material/styles' imports won't be split when '@mui/material' is in the list. You must directly add '@mui/material/styles' to the list if you want that import to be split."
				},
				"splitMuiImports.excludedModules": {
					"type": "array",
					"default": [
						"adaptV4Theme",
						"createColorScheme",
						"createStyles",
						"createTheme",
						"Experimental_CssVarsProvider",
						"experimental_sx",
						"experimentalStyled",
						"getOverlayAlpha",
						"makeStyles",
						"responsiveFontSizes",
						"shouldSkipGeneratingVar",
						"styled",
						"THEME_ID",
						"Theme",
						"ThemeProvider",
						"unstable_createMuiStrictModeTheme",
						"useTheme",
						"useThemeProps",
						"withStyles",
						"withTheme"
					],
					"description": "Modules that will be excluded from splitting when they are imported from a path that is in the allowed imports list."
				}
			}
		},
		"keybindings": [
			{
				"command": "splitMuiImports.split",
				"key": "ctrl+win+alt+s",
				"when": "editorTextFocus"
			}
		]
	},
	"scripts": {
		"lint": "eslint .",
		"pretest": "npm run lint",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/vscode": "1.90.0",
		"@types/mocha": "10.0.10",
		"@types/node": "22.10.2",
		"eslint": "9.17.0",
		"typescript": "5.7.2",
		"@vscode/test-cli": "0.0.10",
		"@vscode/test-electron": "2.4.1"
	}
}
